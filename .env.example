# NAMINTO.EX — Variables d'environnement
# Copier ce fichier en .env.local et renseigner les valeurs réelles
# du projet Supabase de Naminto.Ex (jamais celui de Naminto Académie).
# .env.local est exclu de git — ne jamais commiter de vraies valeurs ici.

# Projet Supabase — Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé service_role — accès serveur uniquement (Back Office, jobs).
# Ne JAMAIS préfixer par NEXT_PUBLIC_, ne jamais l'exposer au client.
SUPABASE_SERVICE_ROLE_KEY=
