# NAMINTO.EX — Variables d'environnement
# Copier ce fichier en .env.local et renseigner les valeurs réelles
# du projet Supabase de Naminto.Ex (jamais celui de Naminto Académie).
# .env.local est exclu de git — ne jamais commiter de vraies valeurs ici.

# Projet Supabase — Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé service_role — accès serveur uniquement (Back Office, jobs).
# Ne JAMAIS préfixer par NEXT_PUBLIC_, ne jamais l'exposer au client.
SUPABASE_SERVICE_ROLE_KEY=

# QR Engine (Prompt 15) — secret de signature HMAC-SHA256 des QR codes.
# Générer localement, ex. : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Ne JAMAIS préfixer par NEXT_PUBLIC_. Toute rotation invalide tous les
# QR déjà émis (ancien secret nécessaire pour les vérifier).
QR_SIGNING_SECRET=

# Webhooks (Prompt 25) — secret de signature HMAC-SHA256 partagé par les
# 5 adapters SANDBOX (nous simulons à la fois l'émetteur et le
# récepteur). Générer localement, même commande que QR_SIGNING_SECRET.
# Un fournisseur REAL aura son propre schéma de signature documenté par
# lui — TODO_DECISION au moment de sa connexion réelle.
WEBHOOK_SIGNING_SECRET=
